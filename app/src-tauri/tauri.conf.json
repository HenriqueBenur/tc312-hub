{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TC312 Hub",
  "version": "1.0.1",
  "identifier": "com.tc312hub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TC312 Hub",
        "width": 1240,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TC312 Hub",
    "shortDescription": "Configurador do teclado Warrior TC312",
    "longDescription": "Remapeamento de teclas, macros, iluminação RGB e perfis para o teclado Warrior TC312 Royal Cross.",
    "copyright": "Uso pessoal",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
