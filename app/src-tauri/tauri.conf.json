{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TC312 Hub",
  "version": "1.1.1",
  "identifier": "com.tc312hub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TC312 Hub",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#090e11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "TC312 Hub",
    "shortDescription": "Configurador do teclado Warrior TC312",
    "longDescription": "Remapeamento de teclas, macros, iluminação RGB e perfis para o teclado Warrior TC312 Royal Cross.",
    "copyright": "Uso pessoal",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyMkQ5QUM1NkI3MTgyN0QKUldSOWduRnJ4Wm90d25BaCs4MHRJc1ZTVlBBdHZnVVhYT1FwY0w1ajZ2NGt3dW13UGdPak1yY24K",
      "endpoints": ["https://github.com/HenriqueBenur/tc312-hub/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
